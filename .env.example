# Inerxia — MikroTik connection configuration (template)
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must
# NEVER be committed. Keep passwords and credentials out of the repository.
#
# Loading: export the variables before running the service, e.g.:
#   set -a && source .env && set +a
# or use `env_file: .env` in docker-compose.
#
# MIKROTIK_BASE_URL must point at the RouterOS REST API root (the webfig REST
# endpoint ends in /rest) and must be reachable from where the service runs.

# --- Required (the service refuses to start without them) --------------------

# RouterOS REST API endpoint, e.g. http://192.168.88.1/rest or https://router:443/rest
MIKROTIK_BASE_URL=https://router.lan:443/rest

# RouterOS user with API rights (see /user groups: full or read+write policies)
MIKROTIK_USER=api-service-user

# RouterOS password for that user — NEVER commit a real one
MIKROTIK_PASSWORD=CHANGE_ME_YOUR_PASSWORD

# --- Optional (safe defaults shown) ------------------------------------------

# Handshake timeout in seconds (default 10)
MIKROTIK_CONNECT_TIMEOUT_SECONDS=10

# Total request timeout in seconds (default 30)
MIKROTIK_TIMEOUT_SECONDS=30

# Verify TLS certificates; set to 'false' only for self-signed lab routers
MIKROTIK_VERIFY_TLS=true

# Address list name that receives suspended subscribers (default: suspended)
MIKROTIK_SUSPENDED_LIST=suspended

# Prefix for per-subscriber queue names (default: inerxia-)
MIKROTIK_QUEUE_PREFIX=inerxia-

# Prefix for object comments tagging contracts (default: inerxia:)
MIKROTIK_CONTRACT_COMMENT_PREFIX=inerxia:

# Comment on the firewall drop rule (default: inerxia:baja-automatica)
MIKROTIK_BLOCKING_RULE_COMMENT=inerxia:baja-automatica